{
  "expo": {
    "name": "OrthoMaster",
    "slug": "OrthoMaster",
    "version": "2.4.0",
    "orientation": "portrait",
    "scheme": "orthomaster",
    "jsEngine": "hermes",
    "platforms": [
      "ios",
      "android"
    ],
    "icon": "./assets/v2_images/logo/icon.png",
    "splash": {
      "image": "./assets/v2_images/logo/logo_primary_1024.png"
    },
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "assetBundlePatterns": [
      "**/*"
    ],
    "notification": {
      "icon": "./assets/notification/icon.png",
      "color": "#FFAF31"
    },
    "ios": {
      "supportsTablet": true,
      "googleServicesFile": "./GoogleService-Info.plist",
      "useNextNotificationsApi": true,
      "bundleIdentifier": "com.hugotaieb.OrthoMaster",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSPhotoLibraryUsageDescription": "Accès à vos photos pour ajouter des images.",
        "NSMicrophoneUsageDescription": "Utilisé pour enregistrer de l’audio.",
        "NSFaceIDUsageDescription": "Utilisé pour sécuriser l’accès à l’application.",
        "NSCameraUsageDescription": "La caméra est utilisée pour scanner des contenus ou ajouter des médias à votre profil.",
        "NSUserNotificationUsageDescription": "Les notifications sont utilisées pour envoyer des rappels, des mises à jour de contenu et des informations importantes."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/v2_images/logo/adaptive_icon.png",
        "backgroundColor": "#FF9600"
      },
      "package": "com.hugotaieb.OrthoMaster",
      "autoIncrement": true,
      "googleServicesFile": "./google-services.json",
      "infoPlist": {
        "UIBackgroundModes": [
          "fetch",
          "remote-notification",
          "fetch",
          "remote-notification",
          "fetch",
          "remote-notification",
          "fetch",
          "remote-notification"
        ],
        "ITSAppUsesNonExemptEncryption": false
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "orthomaster"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "runtimeVersion": {
        "policy": "appVersion"
      },
      "permissions": [
        "INTERNET"
      ]
    },
    "extra": {
      "eas": {
        "projectId": "276593fa-b663-4367-8b00-3d86821c874a"
      }
    },
    "plugins": [
      "expo-secure-store",
      "./expo-plugins/modify-appdelegate.cjs",
      "expo-asset",
      "expo-font",
      [
        "expo-video",
        {
          "supportsBackgroundPlayback": true,
          "supportsPictureInPicture": true
        }
      ],
      [
        "react-native-video",
        {
          "iosCategory": "playback"
        }
      ],
      [
        "@stripe/stripe-react-native",
        {
          "enableGooglePay": true
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/v2_images/logo/icon.png",
          "color": "#FFAF31"
        }
      ],
      "expo-router"
    ],
    "updates": {
      "url": "https://u.expo.dev/276593fa-b663-4367-8b00-3d86821c874a"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}