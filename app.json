{
  "expo": {
    "name": "OrthoMaster",
    "slug": "OrthoMaster",
    "version": "2.4.0",
    "orientation": "portrait",
    "scheme": "orthomaster",
    "jsEngine": "hermes",
    "platforms": [
      "ios",
      "android"
    ],
    "icon": "./assets/appicon.png",
    "splash": {
      "image": "./assets/appicon.png"
    },
    "userInterfaceStyle": "light",
    
    "newArchEnabled": true,
    "assetBundlePatterns": [
      "**/*"
    ],
    "notification": {
      "icon": "./assets/notification/icon.png",
      "color": "#FFAF31"
    },
    "ios": {
      "supportsTablet": true,
      "googleServicesFile": "./GoogleService-Info.plist",
      "infoPlist": {
        "UIBackgroundModes": [
          "fetch",
          "remote-notification",
          "fetch",
          "remote-notification"
        ],
        "ITSAppUsesNonExemptEncryption": false
      },
      "bundleIdentifier": "com.hugotaieb.OrthoMaster"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/appicon.png",
        "backgroundColor": "#FFFFFF"
      },
      "package": "com.hugotaieb.OrthoMaster",
      "versionCode": 62,
      "googleServicesFile": "./google-services.json",
      "intentFilters": [
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "orthomaster"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "runtimeVersion": {
        "policy": "appVersion"
      },
      "compileSdkVersion": 34,
      "targetSdkVersion": 34,
      "buildToolsVersion": "34.0.0"
    },
    "extra": {
      "eas": {
        "projectId": "276593fa-b663-4367-8b00-3d86821c874a"
      }
    },
    "plugins": [
      "expo-secure-store",
      "expo-video",
      "./expo-plugins/modify-appdelegate.cjs",
      "expo-asset",
      "expo-font"
    ],
    "updates": {
      "url": "https://u.expo.dev/276593fa-b663-4367-8b00-3d86821c874a"
    }
  }
}
